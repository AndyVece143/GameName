    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: isBossFightTrigger
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: Hello, my daughter. It seems that you have made it this far.
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: Dad! I'm here to stop you!
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: How interesting... the girl who was too scared to talk back to me earlier
        tonight is facing me down right now.
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: It seems that you have found some strength. From where, is none of my
        business.
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[4]'
      value: If there's one thing I hate, it's children that don't know their place
        in the world!
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[5]'
      value: I'm gonna crush your newfound confidence, and render you unable to stand
        up to me again!
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[6]'
      value: Try all you want Dad! You're never gonna stop me!
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[7]'
      value: You can't stop me.
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'changes.Array.data[1]'
