      value: 
      objectReference: {fileID: 357313892532197023, guid: 5f263dfd62bfa0545be704bdf4a73a40, type: 3}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: react
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: mainCamera
      value: 
      objectReference: {fileID: 1726647342}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: lines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: changes.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: Oh hey! Before you begin your journey, I have some last minute advice,
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: This is an ancient proverb around these lands, although the meaning
        has been lost to time.
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: 'Maybe you can figure out the meaning. Here it is:'
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: '"Use WASD and the arrow keys to move. Press the space bar to jump."'
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[4]'
      value: '"Space also lets you interact with your surroundings."'
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[5]'
      value: '"Press P to pause the game."'
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[6]'
      value: ...did any of that make sense to you?
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'lines.Array.data[7]'
      value: ...I have no idea.
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: 'changes.Array.data[7]'
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3599949493136733232, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
      propertyPath: emotionChanges.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 5853417514905734336, guid: a310180629dcc7c45a5144e04a09cef7, type: 3}
